    "clean": "rm -rf lib",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "deploy": "npm publish",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
