{
  "name": "@dank-inc/super-mouse",
  "version": "0.13.0",
  "author": "Elijah Lucian",
  "description": "A dank mouse utility!",
  "repository": {
    "type": "git",
    "url": "https://github.com/dank-inc/super-mouse"
  },
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "mouse",
    "physics",
    "fun",
    "listeners",
    "event",
    "interactive",
    "creative"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run clean && tsc && npm run build:browser",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest run",
    "clean": "rm -rf lib",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "deploy": "npm publish",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "build:browser": "esbuild src/gravity.ts --bundle --format=iife --global-name=SuperMouseGravity --target=es2020 --outfile=lib/gravity.browser.js"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
